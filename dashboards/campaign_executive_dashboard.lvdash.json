{
  "datasets": [
    {
      "name": "exec_ds",
      "displayName": "Executive summary",
      "queryLines": [
        "SELECT * FROM blackbaud_demo_bbcon.default.exec_summary"
      ]
    },
    {
      "name": "scenario_ds",
      "displayName": "What-if scenarios",
      "queryLines": [
        "SELECT scenario, sort_order, forecast FROM blackbaud_demo_bbcon.default.scenario_forecast ORDER BY sort_order"
      ]
    },
    {
      "name": "stage_ds",
      "displayName": "Pipeline by stage",
      "queryLines": [
        "SELECT stage, weighted FROM blackbaud_demo_bbcon.default.pipeline_by_stage"
      ]
    },
    {
      "name": "designation_ds",
      "displayName": "Designation attainment",
      "queryLines": [
        "SELECT designation_name, goal_amount, raised_amount, pct_to_goal FROM blackbaud_demo_bbcon.default.designation_attainment ORDER BY raised_amount DESC LIMIT 15"
      ]
    },
    {
      "name": "mc_ds",
      "displayName": "Monte Carlo forecast",
      "queryLines": [
        "SELECT committed, p10, p50, p90, mean, probability_of_goal FROM blackbaud_demo_bbcon.default.montecarlo_forecast"
      ]
    },
    {
      "name": "mc_band_ds",
      "displayName": "Forecast band",
      "queryLines": [
        "SELECT 'P10 (pessimistic)' AS scenario, 1 AS sort_order, p10 AS forecast FROM blackbaud_demo_bbcon.default.montecarlo_forecast UNION ALL SELECT 'P50 (expected)', 2, p50 FROM blackbaud_demo_bbcon.default.montecarlo_forecast UNION ALL SELECT 'P90 (optimistic)', 3, p90 FROM blackbaud_demo_bbcon.default.montecarlo_forecast ORDER BY sort_order"
      ]
    },
    {
      "name": "nba_ds",
      "displayName": "Next best ask",
      "queryLines": [
        "SELECT prospect_name, recency_days, frequency, lifetime_giving, rfm_score, suggested_ask FROM blackbaud_demo_bbcon.default.prospect_next_best_ask WHERE lifetime_giving > 0 LIMIT 25"
      ]
    },
    {
      "name": "action_opps_ds",
      "displayName": "Priority open opportunities",
      "queryLines": [
        "SELECT stage, ROUND(ask_amount,0) AS ask_amount, ROUND(weighted_amount,0) AS weighted_amount FROM blackbaud_demo_bbcon.default.opp_enriched WHERE win_probability>0 AND win_probability<1 ORDER BY ask_amount DESC LIMIT 15"
      ]
    }
  ],
